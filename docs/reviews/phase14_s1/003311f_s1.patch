+                        (quad.ul, quad.ur), (quad.ll, quad.lr),
+                        (quad.ul, quad.ll), (quad.ur, quad.lr))):
+                    primitive = _mark(p1, p2, page_number=page_number,
+                                      kind="quad_edge", weight=weight,
+                                      drawing_index=drawing_index,
+                                      item_index=item_index,
